{
  "name": "mern-book-search",
  "version": "1.0.0",
  "private": true,
  "main": "server/server.js",
  "scripts": {
    "client": "npm --prefix client start",
    "server": "npm --prefix server start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install": "npm install --prefix server && npm install --prefix client",
    "build": "npm run install && npm run client:build && npm run server:build",
    "client:build": "npm --prefix client run build",
    "server:build": "npm --prefix server run build",
    "start": "node server/dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "concurrently": "^9.1.2",
    "graphql": "^16.11.0"
  }
}
